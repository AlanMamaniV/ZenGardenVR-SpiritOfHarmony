  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ZenGardenVR.Character.ZenGuardianInteraction
  controller: {fileID: 7835481361408787066}
  gaze: {fileID: 72230596821162675}
  playerTransform: {fileID: 0}
  greetingDistance: 5
  conversationDistance: 3
  exitDistance: 6.5
  dialogueLines:
  - "Bienvenido al Jard\xEDn Zen. Soy el Guardi\xE1n de este lugar sagrado."
  - "Cada piedra karesansui, los cerezos sakura y las aguas del r\xEDo representan la armon\xEDa entre la naturaleza y el esp\xEDritu."
  - "\xBFTe gustar\xEDa descubrir los secretos de este jard\xEDn? Enciende los cuatro faroles sagrados y deposita la gema en el altar."
  - "Que la paz y la serenidad gu\xEDen tus pasos en este espacio de contemplaci\xF3n."
  speechBubbleText: {fileID: 0}
  speechBubbleCanvas: {fileID: 0}
  audioSource: {fileID: 6399018814147862388}
  chimeSound: {fileID: 8300000, guid: 8a4a69a1e9b74be085c6bd16c6070889, type: 3}
