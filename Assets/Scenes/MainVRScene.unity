  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>OBJETIVO DEL PEREGRINO</b>\n1. Contempla el jard\xEDn de arena Karesansui.\n2. Cruza el r\xEDo sagrado por el puente tradicional.\n3. Enciende los 4 faroles votivos (Clic sobre ellos).\n4. Coloca la gema en el altar de contemplaci\xF3n.\n5. Encuentra al <b>Zen Guardian</b> en el santuario y conversa con \xE9l.\n\n<b>CONTROLES DE RV & SIMULADOR</b>\n\u2022 <b>Moverse:</b> Teclas W, A, S, D  |  <b>Mirar:</b> Clic Derecho sostenido\n\u2022 <b>Teletransporte:</b> Mantener <i>Espacio</i> + Clic Izquierdo al suelo\n\u2022 <b>Interactuar / Clic:</b> Clic Izquierdo sobre faroles / gemas\n\u2022 <b>Conversar con Guardi\xE1n:</b> Espacio / E  (Y = Asentir, N = Reflexionar)\n\u2022 <b>Recentrar controles/vista:</b> Tecla V  |  <b>Alternar panel:</b> Tecla M o H"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
